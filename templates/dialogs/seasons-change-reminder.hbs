<div class="stonetop-seasons-reminder">

  <header class="stonetop-seasons-reminder-hero">
    <img class="stonetop-seasons-reminder-icon" src="{{seasonIcon}}" alt="">
    <div class="stonetop-seasons-reminder-heading">
      <h2>The Seasons Change</h2>
      <span class="stonetop-seasons-reminder-season">{{seasonLabel}}</span>
    </div>
  </header>

  <p class="stonetop-seasons-reminder-lead">
    A new season has come to Stonetop. Don't forget your seasonal upkeep:
  </p>

  <ul class="stonetop-seasons-reminder-list">
    {{#each reminders}}
    <li class="stonetop-seasons-reminder-item">
      <div class="stonetop-seasons-reminder-item-head">
        <span class="stonetop-seasons-reminder-item-name">{{name}}</span>
        {{#if ../multiChar}}<span class="stonetop-seasons-reminder-item-char">{{character}}</span>{{/if}}
      </div>
      <p class="stonetop-seasons-reminder-item-rule">{{rule}}</p>
    </li>
    {{/each}}
  </ul>

  <footer class="stonetop-seasons-reminder-footer">
    <label class="stonetop-seasons-reminder-dontshow">
      <input type="checkbox" class="stonetop-seasons-reminder-dontshow-input" {{#if dontShowAgain}}checked{{/if}}>
      Don't show this again
    </label>
    <button type="button" class="stonetop-seasons-reminder-ok" data-action="ok">
      <i class="fas fa-check"></i> OK
    </button>
  </footer>

</div>
