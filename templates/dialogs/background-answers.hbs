<form class="stonetop-possession-choices stonetop-background-answers">
	<div class="stonetop-possession-choices-desc stonetop-item-description"><p>{{lead}}</p></div>

	{{#each groups}}
	<div class="stonetop-choice-group">
		<p class="stonetop-choice-group-heading">{{label}}</p>
		<div class="stonetop-choice-subgroup" data-background-answer="{{key}}">
			{{#each options}}
			<label class="stonetop-choice-option-label"{{#if summary}} data-tooltip="{{summary}}" data-tooltip-direction="UP"{{/if}}>
				<input type="radio" class="stonetop-item-check" name="background-answer-{{../key}}" value="{{value}}" {{#if selected}}checked{{/if}}>
				<span class="stonetop-pc-option-label"><strong>{{label}}</strong></span>
			</label>
			{{/each}}
		</div>
	</div>
	{{/each}}

	<footer class="stonetop-pc-footer">
		<button type="button" class="stonetop-pc-done" data-action="choose">{{chooseLabel}}</button>
		<button type="button" class="stonetop-pc-done" data-action="later">{{laterLabel}}</button>
	</footer>
</form>
