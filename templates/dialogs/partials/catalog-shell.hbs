{{!-- The whole body of a catalogue browser (see module/dialogs/CatalogBrowserDialog.js),
      which is why that class renders this file directly as its template rather than
      through a wrapper. It stays registered as the `stonetop.catalog-shell` partial so
      it is compiled at startup, and so the shell can still be embedded in a larger page.

      ONE top-level element, because an AppV1 activateListeners takes its `html` as the
      root — see the note in CatalogBrowserDialog#activateListeners.

      Its tabs must read as one tool rather than as separate windows sharing a frame:
      source tabs (only when there's more than one list), the shared collapsible search
      control, single-select chip groups, a live count, the rows, and the empty state.

      Rows are stamped `filtered` by getData so the first paint already honours the chip
      state; after that the dialog toggles the class in place rather than re-rendering, so
      the list keeps its scroll position and the search box keeps its term.

      A row whose source named a `dragType` also carries it, and is draggable: the pair IS
      the contract the dialog's dragstart reads (see CatalogBrowserDialog#activateListeners),
      so the handler never has to ask which tab is up. --}}

<div class="stonetop-catalog">

	{{#if hasSources}}
	<div class="stonetop-catalog-sources" role="tablist" aria-label="Choose a catalogue">
		{{#each sources}}
		<button type="button" class="stonetop-catalog-source{{#if active}} is-active{{/if}}"
		        data-source="{{key}}" role="tab" aria-selected="{{#if active}}true{{else}}false{{/if}}">
			<i class="{{icon}}" aria-hidden="true"></i>
			<span>{{label}}</span>
			{{#if hasCount}}<span class="stonetop-catalog-source-count">{{count}}</span>{{/if}}
		</button>
		{{/each}}
	</div>
	{{/if}}

	<div class="stonetop-catalog-controls">
		{{> "stonetop.tab-search-control" title=searchTitle placeholder=searchPlaceholder}}

		{{#each groups}}
		<div class="stonetop-catalog-filters" role="group" aria-label="Filter by {{label}}">
			<span class="stonetop-catalog-filters-label">{{label}}</span>

			{{#if isSelect}}
			{{!-- A group with more values than a chip row can carry. The empty option is the
			      unfiltered state, which is the same "" this group's filter state uses, so a
			      select needs none of the click-the-lit-chip-to-clear business. --}}
			<select class="stonetop-catalog-select{{#if anyActive}} is-active{{/if}}"
			        data-group="{{key}}" aria-label="Filter by {{label}}">
				<option value="">{{allLabel}}</option>
				{{#each chips}}
				<option value="{{key}}"{{#if active}} selected{{/if}}>{{label}} ({{count}})</option>
				{{/each}}
			</select>
			{{else}}

			{{!-- A chip is always labelled; its `icon` is optional (the Home chips are steading
			      names and have none). Every chip's tooltip carries how many rows it would
			      leave, so the count never has to compete with the label for room. --}}
			{{#each chips}}
			<button type="button"
			        class="stonetop-catalog-filter{{#if mod}} stonetop-catalog-filter--{{mod}}{{/if}}{{#if active}} is-active{{/if}}"
			        data-group="{{../key}}" data-key="{{key}}"
			        aria-pressed="{{#if active}}true{{else}}false{{/if}}"
			        data-tooltip="{{hint}} ({{count}})" data-tooltip-direction="UP">
				{{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}
				<span>{{label}}</span>
			</button>
			{{/each}}
			{{/if}}
		</div>
		{{/each}}
	</div>

	{{!-- Live count, rewritten by _updateCount on every chip click and keystroke. --}}
	<p class="stonetop-catalog-count">{{total}}</p>

	<div class="stonetop-catalog-list">
		{{#each rows}}
		<div class="stonetop-catalog-row{{#if filtered}} stonetop-catalog-filtered{{/if}}{{#if marked}} is-marked{{/if}}{{#if inactive}} is-inactive{{/if}}"
		     data-key="{{key}}" data-uuid="{{uuid}}" data-search="{{search}}"
		     {{#if dragType}}draggable="true" data-drag-type="{{dragType}}" {{/if}}
		     role="button" tabindex="0" aria-label="Open {{title}}">

			{{!-- Always an image: an entry with no art of its own gets a category marker,
			      dimmed by `is-placeholder` so real art still stands out.

			      draggable="false" so a press on the art drags the ROW: an <img> is draggable
			      by default, and the drag source is the nearest draggable ancestor STARTING AT
			      the grabbed node — so without this, grabbing a monster by its portrait would
			      drag the image file's URL and drop nothing anywhere. --}}
			<div class="stonetop-catalog-thumb">
				<img src="{{img}}" alt="" loading="lazy" draggable="false"
				     class="{{#if placeholderImg}}is-placeholder{{/if}}">
			</div>

			<div class="stonetop-catalog-main">
				<div class="stonetop-catalog-titleline">
					<span class="stonetop-catalog-title">{{title}}</span>
					{{#each flags}}
					<span class="stonetop-catalog-flag{{#if mod}} stonetop-catalog-flag--{{mod}}{{/if}}">{{label}}</span>
					{{/each}}
				</div>

				{{#if summary}}<p class="stonetop-catalog-summary">{{summary}}</p>{{/if}}

				{{#if (or badges.length note)}}
				<div class="stonetop-catalog-badges">
					{{#each badges}}
					<span class="stonetop-catalog-badge{{#if mod}} stonetop-catalog-badge--{{mod}}{{/if}}"
					      {{#if hint}}data-tooltip="{{hint}}" data-tooltip-direction="UP"{{/if}}>
						{{!-- draggable="false" for the same reason as the thumb above: the
						      creature-type disc is an <img>, and grabbing a row by it must
						      still drag the row. --}}
						{{#if img}}<img src="{{img}}" alt="" draggable="false">{{else}}{{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}{{/if}}{{label}}
					</span>
					{{/each}}
					{{#if note}}<span class="stonetop-catalog-note">{{note}}</span>{{/if}}
				</div>
				{{/if}}
			</div>
		</div>
		{{/each}}
	</div>

	<p class="stonetop-catalog-empty">{{empty}}</p>

</div>
