{{!-- THE COLOUR EACH KIND OF TIMELINE ROW WEARS, for the whole world. GM only.

      One row per kind: the chip as a card prints it, painted in the colour this page would wear,
      and the picker beside it. A pick is previewed by hand as it moves (the dialog does not
      re-render, which would shut the picker under the GM's hand) and written only on Save.

      The chip's colour is the inline `--tl-kind`, always: the class alone would read the WORLD'S
      current token, which still shows a saved repaint after the GM has pressed Default here. --}}
<form class="stonetop-timeline-colours" autocomplete="off">
	<p class="stonetop-timeline-colours-intro">{{localize "stonetop.timeline.colours.intro"}}</p>

	<ul class="stonetop-timeline-colours-list">
		{{#each rows}}
		<li class="stonetop-timeline-colours-row stonetop-timeline-kind--{{kind}}" data-kind="{{kind}}" style="--tl-kind: {{colour}};">
			<span class="stonetop-timeline-colours-chip">
				<i class="fas {{icon}}" aria-hidden="true"></i>
				<span>{{label}}</span>
			</span>
			<input type="color" class="stonetop-timeline-colours-pick" value="{{value}}"
			       aria-label="{{pickLabel}}" data-tooltip="{{pickLabel}}">
			<button type="button" class="stonetop-timeline-colours-reset"{{#unless repainted}} hidden{{/unless}}
			        data-tooltip="{{resetLabel}}" aria-label="{{resetLabel}}">
				<i class="fas fa-rotate-left" aria-hidden="true"></i>
				<span>{{localize "stonetop.timeline.colours.reset"}}</span>
			</button>
			<p class="stonetop-timeline-colours-note"{{#unless nudged}} hidden{{/unless}}>
				{{localize "stonetop.timeline.colours.nudged"}}
			</p>
		</li>
		{{/each}}
	</ul>

	{{!-- Affirmative on the LEFT, which is this system's own button order. --}}
	<footer class="stonetop-timeline-colours-actions">
		<button type="button" class="stonetop-cta stonetop-timeline-colours-save">
			{{localize "stonetop.timeline.colours.save"}}
		</button>
		<button type="button" class="stonetop-timeline-colours-cancel">
			{{localize "stonetop.timeline.colours.cancel"}}
		</button>
	</footer>
</form>
