<form class="stonetop-custom-move-form stonetop-love-letter-form" autocomplete="off">
	{{#if isEdit}}
	<div class="stonetop-custom-move-field">
		<label>{{localize "stonetop.character.moves.loveLetter.recipientLabel"}}</label>
		<p class="stonetop-love-letter-recipient-fixed">{{recipientName}}</p>
	</div>
	{{else}}
	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-recipient">{{localize "stonetop.character.moves.loveLetter.recipientLabel"}}</label>
		<select id="stonetop-love-letter-recipient" name="recipient" required>
			{{#each recipients}}
			<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
			{{/each}}
		</select>
	</div>
	{{/if}}

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-name">{{localize "stonetop.character.moves.loveLetter.nameLabel"}}</label>
		<input type="text" id="stonetop-love-letter-name" name="name" value="{{name}}"
		       placeholder="{{localize 'stonetop.character.moves.loveLetter.namePlaceholder'}}" required>
	</div>

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-desc">{{localize "stonetop.character.moves.loveLetter.descriptionLabel"}}</label>
		<textarea id="stonetop-love-letter-desc" name="description" rows="7"
		          placeholder="{{localize 'stonetop.character.moves.loveLetter.descriptionPlaceholder'}}">{{description}}</textarea>
	</div>

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-roll">{{localize "stonetop.character.moves.loveLetter.rollLabel"}}</label>
		<select id="stonetop-love-letter-roll" name="rollType">
			{{#each rollOptions}}
			<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
			{{/each}}
		</select>
		<p class="stonetop-custom-move-hint">{{localize "stonetop.character.moves.loveLetter.rollHint"}}</p>
	</div>

	<div class="stonetop-custom-move-results stonetop-love-letter-results{{#unless hasRoll}} is-hidden{{/unless}}">
		<h4 class="stonetop-custom-move-results-title">{{localize "stonetop.character.moves.loveLetter.resultsTitle"}}</h4>
		<div class="stonetop-custom-move-field stonetop-love-letter-tier">
			<div class="stonetop-love-letter-tier-head">
				<label for="stonetop-love-letter-success">{{localize "stonetop.character.moves.custom.success"}}</label>
				<label class="stonetop-love-letter-pick">{{localize "stonetop.character.moves.loveLetter.pickLabel"}}
					<input type="number" name="pickSuccess" min="0" max="20" value="{{results.pickSuccess}}"></label>
			</div>
			<textarea id="stonetop-love-letter-success" name="success" rows="2">{{results.success}}</textarea>
		</div>
		<div class="stonetop-custom-move-field stonetop-love-letter-tier">
			<div class="stonetop-love-letter-tier-head">
				<label for="stonetop-love-letter-partial">{{localize "stonetop.character.moves.custom.partial"}}</label>
				<label class="stonetop-love-letter-pick">{{localize "stonetop.character.moves.loveLetter.pickLabel"}}
					<input type="number" name="pickPartial" min="0" max="20" value="{{results.pickPartial}}"></label>
			</div>
			<textarea id="stonetop-love-letter-partial" name="partial" rows="2">{{results.partial}}</textarea>
		</div>
		<div class="stonetop-custom-move-field stonetop-love-letter-tier">
			<div class="stonetop-love-letter-tier-head">
				<label for="stonetop-love-letter-failure">{{localize "stonetop.character.moves.custom.failure"}}</label>
				<label class="stonetop-love-letter-pick">{{localize "stonetop.character.moves.loveLetter.pickLabel"}}
					<input type="number" name="pickFailure" min="0" max="20" value="{{results.pickFailure}}"></label>
			</div>
			<textarea id="stonetop-love-letter-failure" name="failure" rows="2">{{results.failure}}</textarea>
			<label class="stonetop-love-letter-markxp">
				<input type="checkbox" class="stonetop-check" name="markXp" {{#if markXp}}checked{{/if}}>
				{{localize "stonetop.character.moves.loveLetter.markXp"}}
			</label>
		</div>
		<div class="stonetop-custom-move-field">
			<label for="stonetop-love-letter-options">{{localize "stonetop.character.moves.loveLetter.optionsLabel"}}</label>
			<textarea id="stonetop-love-letter-options" name="options" rows="3"
			          placeholder="{{localize 'stonetop.character.moves.loveLetter.optionsPlaceholder'}}">{{options}}</textarea>
			<p class="stonetop-custom-move-hint">{{localize "stonetop.character.moves.loveLetter.optionsHint"}}</p>
		</div>
	</div>

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-signed">{{localize "stonetop.character.moves.loveLetter.signedLabel"}}</label>
		<input type="text" id="stonetop-love-letter-signed" name="signed" value="{{signed}}"
		       placeholder="{{localize 'stonetop.character.moves.loveLetter.signedPlaceholder'}}">
	</div>

	<div class="stonetop-custom-move-actions">
		<button type="button" class="stonetop-custom-move-save stonetop-love-letter-save">
			<i class="fas fa-feather" aria-hidden="true"></i> {{localize "stonetop.character.moves.loveLetter.save"}}
		</button>
		<button type="button" class="stonetop-custom-move-cancel stonetop-love-letter-cancel">{{localize "Cancel"}}</button>
	</div>
</form>
