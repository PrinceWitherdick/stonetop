{{!-- MAKE CAMP, around one fire (Book I p.334). Every character at the camp is a row: the rows the
      viewer drives are controls, and every other row is sentences. Built by
      module/camp/camp-view.js#campWindowView, wired by module/camp/CampWindow.js.

      A label's words always sit in ONE <span>: the labels are flex rows, and bare text beside an
      <em> would be two flex items, gapped apart and wrapping between them. --}}
<div class="stonetop-spring stonetop-camp">

  <div class="stonetop-guide-main">

    <div class="stonetop-guide-banner">
      <i class="fas fa-campground stonetop-guide-banner-icon" aria-hidden="true"></i>
      <div class="stonetop-guide-banner-info">
        <div class="stonetop-guide-banner-title">{{title}}</div>
        <div class="stonetop-guide-banner-sub">Answer the GM's questions about the campsite, then share out the food and settle in.</div>
      </div>
    </div>

    {{#if isOpen}}
    <section class="stonetop-camp-meal{{#if meal.isShort}} is-short{{/if}}{{#if meal.isPaid}} is-paid{{/if}}" aria-live="polite">
      <h3 class="stonetop-camp-heading">The meal</h3>
      <p class="stonetop-camp-meal-line">{{meal.mouthsText}}{{#if meal.cookText}} {{meal.cookText}}{{/if}}</p>
      {{#if meal.costText}}<p class="stonetop-camp-meal-line stonetop-camp-meal-cost">{{meal.costText}}</p>{{/if}}
      {{#if meal.statusText}}<p class="stonetop-camp-meal-status">{{meal.statusText}}</p>{{/if}}
    </section>

    <ol class="stonetop-camp-rows">
      {{#each rows}}
      <li class="stonetop-camp-row{{#if isMine}} is-mine{{/if}}" data-actor-id="{{actorId}}">
        <header class="stonetop-camp-row-head">
          {{#if img}}<img class="stonetop-camp-portrait" src="{{img}}" alt="">{{/if}}
          <h4 class="stonetop-camp-name">{{name}}</h4>
          <span class="stonetop-camp-state {{stateClass}}">{{stateText}}</span>
        </header>

        {{#if canEdit}}
        <div class="stonetop-camp-part">
          <p class="stonetop-camp-part-label">Sharing food</p>
          {{#each purses}}
          <div class="stonetop-camp-line stonetop-camp-purse">
            <span class="stonetop-camp-line-label">{{label}} <span class="stonetop-camp-purse-left">({{remaining}} left)</span></span>
            <span class="stonetop-camp-stepper">
              <button type="button" class="stonetop-camp-step" data-camp-action="offer-take" data-actor-id="{{../actorId}}" data-slug="{{slug}}" data-camp-focus="{{../actorId}}:take:{{slug}}" aria-label="Take back one use of {{label}}"{{#unless canTake}} disabled{{/unless}}>&minus;</button>
              <span class="stonetop-camp-count">{{n}}</span>
              <button type="button" class="stonetop-camp-step" data-camp-action="offer-add" data-actor-id="{{../actorId}}" data-slug="{{slug}}" data-camp-focus="{{../actorId}}:add:{{slug}}" aria-label="Share one more use of {{label}}"{{#unless canAdd}} disabled{{/unless}}>+</button>
            </span>
          </div>
          {{else}}
          <p class="stonetop-camp-says">Nothing to eat in this pack.</p>
          {{/each}}
          {{#if cover.show}}
          <button type="button" class="stonetop-camp-inline-btn" data-camp-action="cover" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:cover"><i class="fas fa-hand-holding-heart" aria-hidden="true"></i> {{cover.label}}</button>
          {{/if}}
          {{#if givesBackText}}<p class="stonetop-camp-note">{{givesBackText}}</p>{{/if}}
        </div>

        <div class="stonetop-camp-part">
          <p class="stonetop-camp-part-label">Eating</p>
          {{#if unliving}}
          <p class="stonetop-camp-says">Needs no food or sleep (Unliving), and takes nothing from the night.</p>
          {{else}}
          <label class="stonetop-camp-check"><input type="checkbox" data-camp-field="eats" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:eats"{{#if eats}} checked{{/if}}><span>Eats tonight</span></label>
          {{/if}}
          <div class="stonetop-camp-line">
            <span class="stonetop-camp-line-label">Followers eating too</span>
            <span class="stonetop-camp-stepper">
              <button type="button" class="stonetop-camp-step" data-camp-action="followers-take" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:followers-take" aria-label="One fewer follower eating"{{#unless canTakeFollower}} disabled{{/unless}}>&minus;</button>
              <span class="stonetop-camp-count">{{followers}}</span>
              <button type="button" class="stonetop-camp-step" data-camp-action="followers-add" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:followers-add" aria-label="One more follower eating"{{#unless canAddFollower}} disabled{{/unless}}>+</button>
            </span>
          </div>
          {{#if messKit.carries}}
          <label class="stonetop-camp-check"><input type="checkbox" data-camp-field="messKit" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:messKit"{{#if messKit.uses}} checked{{/if}}><span>Cook with the mess kit, so 1 use feeds 4 <em>(needs fire and water)</em></span></label>
          {{/if}}
        </div>

        {{#if night.show}}
        <fieldset class="stonetop-camp-part stonetop-camp-night">
          <legend class="stonetop-camp-part-label">The night: pick 1</legend>
          <label class="stonetop-camp-check"><input type="radio" name="{{night.radioName}}" value="hp" data-camp-field="benefit" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:benefit-hp"{{#if night.hp}} checked{{/if}}><span>Regain half your max HP: {{night.hpBefore}} &rarr; {{night.hpAfter}}</span></label>
          {{#if night.hasDebilities}}
          <div class="stonetop-camp-line">
            <label class="stonetop-camp-check"><input type="radio" name="{{night.radioName}}" value="debility" data-camp-field="benefit" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:benefit-debility"{{#if night.debility}} checked{{/if}}><span>Clear a debility:</span></label>
            <select data-camp-field="debility" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:debility" aria-label="Which debility to clear">{{#each night.debilities}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{name}}</option>{{/each}}</select>
          </div>
          {{/if}}
          <label class="stonetop-camp-check"><input type="radio" name="{{night.radioName}}" value="none" data-camp-field="benefit" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:benefit-none"{{#if night.none}} checked{{/if}}><span>No real sleep tonight, so no pick</span></label>
          {{#if bedroll.carries}}
          <label class="stonetop-camp-check"><input type="checkbox" data-camp-field="bedroll" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:bedroll"{{#if bedroll.uses}} checked{{/if}}><span>Sleep in the bedroll: regain 1d6 extra HP</span></label>
          {{/if}}
          <label class="stonetop-camp-check"><input type="checkbox" data-camp-field="peaceful" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:peaceful"{{#if peaceful}} checked{{/if}}><span>The rest was peaceful, comfortable or enjoyable: advantage on the next roll</span></label>
        </fieldset>
        {{/if}}

        {{#if showFoot}}
        <div class="stonetop-camp-row-foot">
          <label class="stonetop-camp-check stonetop-camp-ready"><input type="checkbox" data-camp-field="ready" data-actor-id="{{actorId}}" data-camp-focus="{{actorId}}:ready"{{#if ready}} checked{{/if}}><span>Ready to eat and rest</span></label>
          <button type="button" class="stonetop-camp-inline-btn stonetop-camp-leave" data-camp-action="leave" data-actor-id="{{actorId}}"><i class="fas fa-right-from-bracket" aria-hidden="true"></i> Leave the camp</button>
        </div>
        {{/if}}
        {{else}}
        {{#each says}}<p class="stonetop-camp-says">{{this}}</p>{{/each}}
        {{/if}}
      </li>
      {{/each}}
    </ol>

    {{#if add.show}}
    <div class="stonetop-camp-add">
      <label class="stonetop-camp-line"><span>Bring someone to the fire:</span>
        <select name="campAddActor">{{#each add.options}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
      </label>
      <button type="button" class="stonetop-camp-inline-btn" data-camp-action="add"><i class="fas fa-user-plus" aria-hidden="true"></i> Bring them</button>
    </div>
    {{/if}}
    {{else}}
    <p class="stonetop-camp-closed">{{closedText}}</p>
    {{/if}}

  </div>

  <div class="stonetop-guide-nav">
    {{#if nav.manages}}
    <button type="button" class="stonetop-guide-btn--primary stonetop-camp-settle" data-camp-action="settle"{{#unless nav.canSettle}} disabled{{/unless}}><i class="fas fa-fire" aria-hidden="true"></i> Make Camp</button>
    <span class="stonetop-camp-nav-hint">{{nav.hint}}</span>
    <button type="button" class="stonetop-camp-break" data-camp-action="break"{{#unless isOpen}} disabled{{/unless}}>Break up the camp</button>
    {{else}}
    <span class="stonetop-camp-nav-hint">{{nav.hint}}</span>
    {{/if}}
  </div>

</div>
