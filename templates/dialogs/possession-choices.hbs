<form class="stonetop-possession-choices">
	{{#if description}}
	<div class="stonetop-possession-choices-desc stonetop-item-description">{{{description}}}</div>
	{{/if}}

	{{#each groups}}
	<div class="stonetop-choice-group">
		<p class="stonetop-choice-group-heading">{{{heading}}}{{#if note}} <em>({{note}})</em>{{/if}}</p>
		{{#each subgroups}}
		<div class="stonetop-pc-subgroup stonetop-choice-subgroup"{{#if max}} data-max="{{max}}"{{/if}}>
			{{#if max}}
			<span class="stonetop-pc-cap"><span class="stonetop-pc-count">{{selectedCount}}</span> / {{max}}</span>
			{{/if}}
			{{#each options}}
			<label class="stonetop-choice-option-label{{#if disabled}} is-disabled{{/if}}{{#if locked}} is-locked{{/if}}">
				{{#if ../multiSelect}}
				<input type="checkbox" class="stonetop-item-check stonetop-pc-sub-check"
				       data-possession-slug="{{@root.possessionSlug}}" data-choice-slug="{{slug}}"
				       {{#if checked}}checked{{/if}} {{#if disabled}}disabled{{/if}}>
				{{else}}
				<input type="radio" class="stonetop-pc-sub-radio"
				       name="pc-{{../groupId}}"
				       data-possession-slug="{{@root.possessionSlug}}" data-choice-slug="{{slug}}"
				       data-sibling-slugs-csv="{{../slugsCsv}}"
				       {{#if checked}}checked{{/if}}>
				{{/if}}
				<span class="stonetop-pc-option-label">{{{label}}}</span>
				{{#if locked}}<i class="fas fa-lock stonetop-pc-locked-icon" title="Already chosen"></i>{{/if}}
			</label>
			{{/each}}
		</div>
		{{/each}}
	</div>
	{{/each}}

	<footer class="stonetop-pc-footer">
		<button type="button" class="stonetop-pc-done">Done</button>
	</footer>
</form>
