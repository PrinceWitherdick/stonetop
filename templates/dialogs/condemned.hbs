<div class="stonetop-condemned-body">

	{{!-- Whose moves these are, then what they have in common: both of the Judge's standing lists
	      end only when the Judge ends them, and that is the clause a table forgets. Each section
	      quotes its own move below; this line is what is true of the window. --}}
	<div class="stonetop-condemned-heading">
		{{#if playbookImg}}
		<img class="stonetop-condemned-mark" src="{{playbookImg}}" alt="" draggable="false">
		{{/if}}
		<p class="stonetop-condemned-rule">{{localize "stonetop.condemn.windowRule"}}</p>
	</div>

	{{#if showBrands}}
	{{!-- The brands. A section rather than a bare list, because it is also the drop target for
	      "brand this person" and has to be distinguishable from the oaths' one below. --}}
	<section class="stonetop-condemned-section">
		{{#if showHeadings}}
		<h3 class="stonetop-condemned-section-heading">{{localize "stonetop.condemn.brandsHeading"}}</h3>
		{{/if}}
		<p class="stonetop-condemned-section-rule">{{localize "stonetop.condemn.rule"}}</p>

		{{#if hasRows}}
		<ul class="stonetop-condemned-list">
			{{#each rows}}
			{{!-- Nothing in the block: a brand is a name, a link and a reason, with nothing beside
			      the name the way an oath has its broken tick. --}}
			{{#> "stonetop.roster-row" prefix="stonetop-condemned" editable=../editable
			     openClass="stonetop-condemned-open" noteClass="stonetop-condemned-note"
			     noteTextClass="stonetop-condemned-note-text"
			     notePlaceholder=(localize "stonetop.condemn.notePlaceholder")
			     removeClass="stonetop-condemned-dismiss"
			     removeLabel=(localize "stonetop.condemn.dismissLabel" name=name)}}{{/"stonetop.roster-row"}}
			{{/each}}
		</ul>
		{{else}}
		<p class="stonetop-condemned-empty">{{localize "stonetop.condemn.empty"}}</p>
		{{/if}}

		{{#if canBrand}}
		{{!-- Free-type, backed by a datalist of world actors: a Censure most often lands on somebody
		      nobody has made an Actor for, and a Proclamation's faction never has one at all. A typed
		      name that matches an actor exactly is stored as a link to them anyway (see _addTyped), so
		      the two ways of adding the same person record the same thing. Dropping an Actor onto this
		      section does it without the typing. --}}
		<div class="stonetop-condemned-add">
			<input type="text" class="stonetop-condemned-name" list="stonetop-condemned-suggestions"
			       autocomplete="off" placeholder="{{localize "stonetop.condemn.addPlaceholder"}}">
			{{!-- `label` is where a native datalist already means "the aside beside this option", and
			      it is what StonetopAutocomplete renders as the dimmed second column. Only `value` is
			      ever inserted into the field, so a picked "Brennan the Claw / Marshedge" types just
			      the name and the search resolves it cleanly. --}}
			<datalist id="stonetop-condemned-suggestions">
				{{#each suggestions}}<option value="{{value}}"{{#if hint}} label="{{hint}}"{{/if}}></option>{{/each}}
			</datalist>
			<button type="button" class="stonetop-condemned-add-btn">{{localize "stonetop.condemn.add"}}</button>
		</div>
		<p class="stonetop-condemned-hint">{{localize "stonetop.condemn.dropHint"}}</p>
		{{/if}}
	</section>
	{{/if}}

	{{#if showOaths}}
	{{!-- The oaths (Binding Arbitration). Same construction as the brands above, plus the one thing
	      an oath has that a brand does not: whether it has been BROKEN, which is the mechanical
	      half of the move ("advantage on all rolls against them until they admit their wrong"). --}}
	<section class="stonetop-oath-section">
		{{#if showHeadings}}
		<h3 class="stonetop-condemned-section-heading">{{localize "stonetop.oaths.heading"}}</h3>
		{{/if}}
		<p class="stonetop-condemned-section-rule">{{localize "stonetop.oaths.rule"}}</p>

		{{#if hasOaths}}
		<ul class="stonetop-condemned-list stonetop-oath-list">
			{{#each oaths}}
			{{#> "stonetop.roster-row" prefix="stonetop-condemned" editable=../editable
			     rowClass="stonetop-oath-row" openClass="stonetop-condemned-open"
			     noteClass="stonetop-oath-note" noteTextClass="stonetop-condemned-note-text"
			     notePlaceholder=(localize "stonetop.oaths.notePlaceholder")
			     removeClass="stonetop-oath-release"
			     removeLabel=(localize "stonetop.oaths.releaseLabel" name=name)}}
			{{!-- The one thing an oath has that a brand does not. A tick box where the sheet can be
			      written to, a plain tag where it cannot: the Judge learns this by ASKING, at a
			      moment that has nothing to do with the roll it later affects, so ticking it is how
			      the answer survives to that roll.

			      `editable` unqualified, NOT `../editable`: inside a partial's block the hash
			      arguments have pushed a frame, so `../` no longer walks out to the dialog context
			      the way it does in a plain `{{#each}}` — and it fails by quietly reading undefined,
			      which renders the read-only face to somebody who can in fact write. --}}
			{{#if editable}}
			<label class="stonetop-oath-broken-control"
			       data-tooltip="{{localize "stonetop.oaths.brokenTooltip"}}" data-tooltip-direction="UP">
				<input type="checkbox" class="stonetop-check stonetop-oath-broken" data-row-id="{{id}}"
				       {{#if broken}}checked{{/if}}>
				<span class="stonetop-oath-broken-label">{{localize "stonetop.oaths.broken"}}</span>
			</label>
			{{else}}{{#if broken}}
			<span class="stonetop-oath-broken-tag"
			      data-tooltip="{{localize "stonetop.oaths.brokenTooltip"}}" data-tooltip-direction="UP">{{localize "stonetop.oaths.broken"}}</span>
			{{/if}}{{/if}}
			{{/"stonetop.roster-row"}}
			{{/each}}
		</ul>
		{{else}}
		<p class="stonetop-condemned-empty">{{localize "stonetop.oaths.empty"}}</p>
		{{/if}}

		{{#if canWitness}}
		<div class="stonetop-condemned-add">
			<input type="text" class="stonetop-oath-name" list="stonetop-oath-suggestions"
			       autocomplete="off" placeholder="{{localize "stonetop.oaths.addPlaceholder"}}">
			<datalist id="stonetop-oath-suggestions">
				{{#each oathSuggestions}}<option value="{{value}}"{{#if hint}} label="{{hint}}"{{/if}}></option>{{/each}}
			</datalist>
			<button type="button" class="stonetop-oath-add-btn">{{localize "stonetop.oaths.add"}}</button>
		</div>
		<p class="stonetop-condemned-hint">{{localize "stonetop.oaths.dropHint"}}</p>
		{{/if}}
	</section>
	{{/if}}

</div>
