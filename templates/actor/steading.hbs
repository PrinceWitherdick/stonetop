<form class="{{cssClass}} steading-sheet" autocomplete="off">
	<div class="sheet-wrapper steading-sheet-wrapper">

		<div class="steading-header">
			<div class="steading-header-name">
				<h1 class="steading-title">Stonetop</h1>
			</div>
			{{!-- The campaign's clock, beside the title: the season the table is playing in and
			      the year it belongs to, stamped by the Seasons Change move (see
			      module/seasons/current-season.js). The season half is absent until the first
			      Seasons Change is recorded — the year is always known, so it always shows.

			      A GM can click it to correct what it says without running the move; a player
			      gets the same readout as plain text. Rendered as a <button> for the GM rather
			      than a clickable <div> so it is keyboard-reachable and announces itself.

			      Complementary `{{#if}}` / `{{#unless}}` rather than one `{{#if}}/{{else}}`,
			      the same shape the layout guards below use — this file's markup is asserted
			      to be branch-free of `{{else}}` so that the classic/modern split can never
			      become two whole copies of the sheet (tests/actors/steading/
			      steading-section-placement.test.js). The readout itself is a partial, so the
			      two wrappers cannot drift apart. --}}
			{{#if stonetop.isGM}}
			<button type="button" class="steading-header-season steading-header-season--set"
			        data-action="set-current-season"
			        data-tooltip="{{localize "stonetop.steading.season.setTooltip"}}">
				{{> "stonetop.steading-header-season" season=stonetop.currentSeason}}
			</button>
			{{/if}}
			{{#unless stonetop.isGM}}
			<div class="steading-header-season">
				{{> "stonetop.steading-header-season" season=stonetop.currentSeason}}
			</div>
			{{/unless}}
		</div>

		{{!-- CLASSIC only: the stat band is a permanent strip above the tab strip, the way it
		      was before the icon rail took the sheet's right edge. The SAME partial the Overview
		      tab mounts in the modern layout - only the position differs, and the two guards are
		      complementary so only one ever renders. It must be invoked at TOP LEVEL:
		      steading-stats-bar.hbs reaches up with `../stonetop.edit.*`, so mounting it inside
		      an {{#each}} or with a `this=` override silently renders the band read-only. --}}
		{{#if stonetop.classicLayout}}{{> "stonetop.steading-stats-bar"}}{{/if}}

		{{!-- One <nav> for both layouts, differing by a class and a single entry - not two navs
		      behind {{#if}}/{{else}}, which is two copies of a six-entry list to keep in step.
		      The same shape the character sheet uses.

		      MODERN wears `stonetop-tab-rail`, which is what tab-rail.js keys off to lift this
		      nav onto the window frame (so its position here is arbitrary) and what every
		      `:not(.stonetop-tab-rail)` in the horizontal-strip skin excludes.

		      CLASSIC gets one entry fewer: Homefront Moves is the SIDEBAR there, so it has
		      no page of its own, and the `moves` panel below is dropped with it - a `.tab` with
		      no nav entry is dead markup that still costs a render. A user sitting on `moves`
		      when the setting flips is handled by core: Tabs#activate falls back to the first
		      nav item when the stored name is absent, and stores the fallback.

		      Homefront Moves sits second in modern: it used to be a sidebar visible from every
		      tab, so it is the one page reached most often. --}}
		<nav class="sheet-tabs tabs{{#unless stonetop.classicLayout}} stonetop-tab-rail{{/unless}}"
		     data-group="primary" aria-label="{{localize "stonetop.sheet.tabs.railLabel"}}">
			{{> "stonetop.tab-nav-item" tab="overview"     label=(localize "stonetop.steading.tabs.overview")}}
			{{#unless stonetop.classicLayout}}{{> "stonetop.tab-nav-item" tab="moves" label=(localize "stonetop.steading.tabs.moves")}}{{/unless}}
			{{> "stonetop.tab-nav-item" tab="neighbors"    label=(localize "stonetop.steading.tabs.neighbors")}}
			{{> "stonetop.tab-nav-item" tab="improvements" label=(localize "stonetop.steading.tabs.improvements")}}
			{{!-- Threats & Dangers and Sites used to sit here. They are the GM's own prep,
			      written for one pair of eyes, so they moved to the GM Toolkit sheet. Their
			      STORAGE did not move: both are still journal pages filed under this steading
			      (module/journal/gm-prep-page-store.js), so nothing about a world's existing
			      prep changed, only where the GM reads it. --}}
			{{> "stonetop.tab-nav-item" tab="notes"        label=(localize "stonetop.steading.tabs.notes")}}
		</nav>

		<div class="stonetop-sheet-layout steading-sheet-layout stonetop-sheet-layout--own-seam">
			<section class="sheet-body">
				{{> "stonetop.steading-tab-overview"}}
				{{#unless stonetop.classicLayout}}{{> "stonetop.steading-tab-moves"}}{{/unless}}
				{{> "stonetop.steading-tab-neighbors"}}
				{{> "stonetop.steading-tab-improvements"}}
				{{> "stonetop.steading-tab-notes"}}
			</section>

			{{!-- The sidebar and the moves TAB above are the same content in two shapes, so
			      their guards must stay complementary or Homefront Moves renders twice. --}}
			{{#if stonetop.classicLayout}}{{> "stonetop.steading-moves-sidebar"}}{{/if}}
		</div>

	</div>
</form>
