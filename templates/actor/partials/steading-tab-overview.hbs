<div class="tab overview" data-group="primary" data-tab="overview">
	<section class="sheet-tab steading-overview">

		{{!-- Resources, Fortifications, and Assets sit in equal-width columns that
		      stretch to a shared height, filling down to Places of Interest. --}}
		<div class="steading-overview-cards">
			<div class="steading-card steading-edit-section{{#unless stonetop.edit.resources}} stonetop-readonly{{/unless}}">
				{{> "stonetop.steading-section-toggle" section="resources" editing=stonetop.edit.resources}}
				<h3 class="steading-list-heading">Resources</h3>
				<ul class="steading-list">
					{{#each stonetop.resources}}
					{{#if name}}
					<li class="steading-list-item">
						<span class="steading-list-bullet" aria-hidden="true"></span>
						<span class="steading-list-name">{{name}}</span>
						<button type="button" class="steading-list-delete"
						        data-list="resources" data-index="{{@index}}"
						        title="Remove" tabindex="-1">
							<i class="fas fa-times"></i>
						</button>
					</li>
					{{/if}}
					{{/each}}
				</ul>
				{{#if stonetop.canEdit}}
				<button type="button" class="steading-list-add" data-list="resources">
					<i class="fas fa-plus"></i> Add Resource
				</button>
				{{/if}}
			</div>

			<div class="steading-card steading-fortifications-block steading-edit-section{{#unless stonetop.edit.fortifications}} stonetop-readonly{{/unless}}">
				{{> "stonetop.steading-section-toggle" section="fortifications" editing=stonetop.edit.fortifications}}
				<h3 class="steading-list-heading">Fortifications, etc.</h3>
				<ul class="steading-list">
					{{#each stonetop.fortifications}}
					{{#if name}}
					<li class="steading-list-item">
						<span class="steading-list-bullet" aria-hidden="true"></span>
						<span class="steading-list-name">{{name}}</span>
						<button type="button" class="steading-list-delete"
						        data-list="fortifications" data-index="{{@index}}"
						        title="Remove" tabindex="-1">
							<i class="fas fa-times"></i>
						</button>
					</li>
					{{/if}}
					{{/each}}
				</ul>
				{{#if stonetop.canEdit}}
				<button type="button" class="steading-list-add" data-list="fortifications">
					<i class="fas fa-plus"></i> Add Fortification
				</button>
				{{/if}}
			</div>

			<div class="steading-card steading-assets-section steading-edit-section{{#unless stonetop.edit.assets}} stonetop-readonly{{/unless}}">
				{{> "stonetop.steading-section-toggle" section="assets" editing=stonetop.edit.assets}}
				<h3 class="steading-list-heading">Assets
					<span class="steading-list-heading-note">Owned by residents in common. Requisition to use them on expeditions.</span>
				</h3>
				<ul class="steading-list steading-assets-list">
					{{#each stonetop.assets}}
					{{#if name}}
					<li class="steading-list-item">
						<span class="steading-list-bullet" aria-hidden="true"></span>
						<span class="steading-list-name steading-asset-name">{{name}}</span>
						<button type="button" class="steading-list-delete"
						        data-list="assets" data-index="{{@index}}"
						        title="Remove" tabindex="-1">
							<i class="fas fa-times"></i>
						</button>
					</li>
					{{/if}}
					{{/each}}
				</ul>
				{{#if stonetop.canEdit}}
				<button type="button" class="steading-list-add" data-list="assets">
					<i class="fas fa-plus"></i> Add Asset
				</button>
				{{/if}}

				{{!-- Silver & Gold live in the same card as Assets, mirroring the
				      book's combined treasury block; Silver stacks above Gold. --}}
				<div class="steading-currency-section steading-edit-section{{#unless stonetop.edit.currency}} stonetop-readonly{{/unless}}">
					{{> "stonetop.steading-section-toggle" section="currency" editing=stonetop.edit.currency}}
					<div class="steading-currency-groups">
						<div class="steading-currency-group">
							<span class="steading-currency-metal">Silver</span>
							<div class="steading-currency-row">
								<label class="steading-currency-field">
									<span class="steading-currency-field-legend">Purses</span>
									<input type="number" class="steading-currency-input" data-currency="silver" data-field="purses"
									       value="{{stonetop.silver.purses}}" min="0">
								</label>
								<label class="steading-currency-field">
									<span class="steading-currency-field-legend">Handfuls</span>
									<input type="number" class="steading-currency-input" data-currency="silver" data-field="handfuls"
									       value="{{stonetop.silver.handfuls}}" min="0">
								</label>
								<label class="steading-currency-field">
									<span class="steading-currency-field-legend">Coins</span>
									<input type="number" class="steading-currency-input" data-currency="silver" data-field="coins"
									       value="{{stonetop.silver.coins}}" min="0">
								</label>
							</div>
						</div>
						<div class="steading-currency-group">
							<span class="steading-currency-metal">Gold</span>
							<div class="steading-currency-row">
								<label class="steading-currency-field">
									<span class="steading-currency-field-legend">Purses</span>
									<input type="number" class="steading-currency-input" data-currency="gold" data-field="purses"
									       value="{{stonetop.gold.purses}}" min="0">
								</label>
								<label class="steading-currency-field">
									<span class="steading-currency-field-legend">Handfuls</span>
									<input type="number" class="steading-currency-input" data-currency="gold" data-field="handfuls"
									       value="{{stonetop.gold.handfuls}}" min="0">
								</label>
								<label class="steading-currency-field">
									<span class="steading-currency-field-legend">Coins</span>
									<input type="number" class="steading-currency-input" data-currency="gold" data-field="coins"
									       value="{{stonetop.gold.coins}}" min="0">
								</label>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		{{!-- Relationships — how Stonetop stands with the communities beyond it, on
		      the same 1-5 hearts the NPC and character sheets use for their side of a tie.
		      The roster is the book's (module/data/settlements.js) and ships at neutral;
		      clicking a heart sets the rating, clicking the last filled one drops it. The
		      pencil reveals a show/hide box per row so a table can trim the list to the
		      neighbors it actually deals with. Full width, between the inventory cards and
		      Places of Interest. --}}
		<div class="steading-card steading-residents-section steading-residents-section--settlements steading-edit-section{{#unless stonetop.edit.settlements}} stonetop-readonly{{/unless}}">
			{{> "stonetop.steading-section-toggle" section="settlements" editing=stonetop.edit.settlements}}
			{{!-- Table/Board toggle INSIDE the heading, pushed to the far right by margin-left:
			      auto. Inside rather than beside it because this card is the positioning
			      context (the pencil anchors to the card's corner, not the heading's), so an
			      absolutely-placed sibling would sit in the card padding above the heading
			      text. The h3 stays a full-width block, so its underline still spans the card
			      and the buttons sit above it. --}}
			{{!-- Gated like the section body: with no rows, neither layout has anything to
			      show and the toggle would switch between two identical empty states. --}}
			<h3 class="steading-list-heading">Relationships{{#if stonetop.hasSettlements}}{{> "stonetop.relationships-viewbar" resizeKey=stonetop.settlementsRel.resizeKey view=stonetop.settlementsRel.view inHeading=true}}{{/if}}</h3>
			{{#if stonetop.hasSettlements}}
			{{> "stonetop.relationships-view" rows=stonetop.settlements lanes=stonetop.settlementsRel.lanes
			    view=stonetop.settlementsRel.view resizeKey=stonetop.settlementsRel.resizeKey hideViewbar=true
			    nameLabel=(localize "stonetop.steading.settlement") canRate=stonetop.canEdit
			    canToggle=stonetop.edit.settlements
			    showTooltip=(localize "stonetop.steading.settlementShowTooltip")}}
			{{else}}
			<p class="stonetop-rel-empty">{{localize "stonetop.steading.settlementsAllHidden"}}</p>
			{{/if}}
		</div>

		{{!-- Places of Interest gets the full-width bottom row to itself. --}}
		<div class="steading-overview-bottom">
			<div class="steading-card steading-places-section steading-edit-section{{#unless stonetop.edit.places}} stonetop-readonly{{/unless}}">
				{{> "stonetop.steading-section-toggle" section="places" editing=stonetop.edit.places}}
				<h3 class="steading-list-heading">Places of Interest</h3>
				<div class="steading-places-grid">
					{{#each stonetop.places}}
					<div class="steading-place-item" data-letter="{{letter}}">
						<span class="steading-place-letter{{#if name}} steading-place-drag{{/if}}"
						      {{#if name}}draggable="true" title="Drag onto a scene to drop a map note"{{/if}}>{{letter}}</span>
						<input type="text" class="steading-place-name"
						       data-index="{{@index}}"
						       value="{{name}}" placeholder="—" {{#unless @root.stonetop.edit.places}}disabled{{/unless}}>
					</div>
					{{/each}}
				</div>
			</div>
		</div>

	</section>
</div>
