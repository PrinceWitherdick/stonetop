<div class="tab moves{{#if stonetop.hideUnselected}} hide-unselected{{/if}}" data-group="primary" data-tab="moves">
	<section class="sheet-tab">

		{{!-- Love letters (Book I p.568): single-use, GM-authored moves addressed to this
		      PC. The section exists only while at least one letter is on the sheet — the
		      last one vanishes with its section when the player resolves it. Players read
		      and resolve; only the GM sees the edit/delete affordances. --}}
		{{#if stonetop.movelist.loveLetters.length}}
		<div class="stonetop-move-group stonetop-love-letters-section">
			{{> "stonetop.section-heading" title=(localize "stonetop.character.moves.loveLetter.sectionTitle") collapse="loveLetters"}}
			<ol class="items-list">
			{{#each stonetop.movelist.loveLetters}}
				<li class="item stonetop-item stonetop-love-letter" data-item-id="{{ownedId}}">
					<div class="stonetop-item-header">
						<strong class="stonetop-item-name">{{name}}</strong>
						{{#if (and @root.stonetop.canAuthorLoveLetters rollLabel)}}<span class="stonetop-move-roll-chip">+{{rollLabel}}</span>{{/if}}
					</div>
					{{#if description}}<div class="stonetop-item-description">{{{boldMissText description}}}</div>{{/if}}
					<div class="stonetop-love-letter-actions">
						<button type="button" class="stonetop-love-letter-read" data-item-id="{{ownedId}}">
							<i class="fas fa-envelope-open-text" aria-hidden="true"></i> {{localize "stonetop.character.moves.loveLetter.readButton"}}
						</button>
						{{#if @root.stonetop.canAuthorLoveLetters}}
						<a class="stonetop-love-letter-edit" data-item-id="{{ownedId}}" title="{{localize 'stonetop.character.moves.loveLetter.editMove'}}">
							<i class="fas fa-pen"></i>
						</a>
						<a class="stonetop-love-letter-delete" data-item-id="{{ownedId}}" title="{{localize 'stonetop.character.moves.loveLetter.deleteMove'}}">
							<i class="fas fa-trash"></i>
						</a>
						{{/if}}
					</div>
				</li>
			{{/each}}
			</ol>
		</div>
		{{/if}}

		{{#if stonetop.movelist.playbookMoves.length}}
		{{> "stonetop.move-group"
		    title=(localize "stonetop.character.moves.playbookMoves")
		    note=stonetop.movelist.startingMovesNoteDisplay
		    moves=stonetop.movelist.playbookMoves
		    ownedMoves=stonetop.movelist.playbookMovesOwned
		    unownedMoves=stonetop.movelist.playbookMovesUnowned
		    splitUnowned=true
		    hideToggle=true
		    hideUnselected=stonetop.hideUnselected
		    searchControl=true
		    searchTitle=(localize "stonetop.character.moves.searchLabel")
		    searchPlaceholder=(localize "stonetop.character.moves.searchPlaceholder")
		    editSection="moves"
		    collapseId="playbookMoves"
		    editing=stonetop.movesEdit}}
		{{#if stonetop.movelist.movesIncomplete}}
		<div class="stonetop-details-onboarding-actions">
			<button type="button" class="stonetop-choose-moves-btn" data-onboarding-start="moves">
				<i class="fas fa-question-circle" aria-hidden="true"></i>
				{{localize "stonetop.character.moves.chooseStartingMoves"}}
			</button>
		</div>
		{{/if}}
		{{/if}}

		{{#if stonetop.movelist.levelMovesIncomplete}}
		<div class="stonetop-intros-notice stonetop-intros-notice--warn stonetop-moves-level-notice">
			<i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
			<div class="stonetop-moves-level-notice-body">
				<p>
				{{#if (eq stonetop.movelist.levelMovesShortfall 1)}}
					{{localize "stonetop.character.moves.levelMovesIncompleteOne" level=stonetop.movelist.characterLevel}}
				{{else}}
					{{localize "stonetop.character.moves.levelMovesIncompleteMany" count=stonetop.movelist.levelMovesShortfall level=stonetop.movelist.characterLevel}}
				{{/if}}
				</p>
				<p class="stonetop-moves-level-notice-hint">{{localize "stonetop.character.moves.levelMovesIncompleteHint"}}</p>
			</div>
		</div>
		{{/if}}

		{{#if stonetop.movelist.showLevelMovesOverLimit}}
		<div class="stonetop-intros-notice stonetop-intros-notice--warn stonetop-moves-level-notice">
			<i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
			<div class="stonetop-moves-level-notice-body">
				<p>
				{{#if (eq stonetop.movelist.levelMovesOverage 1)}}
					{{localize "stonetop.character.moves.levelMovesOverLimitOne" level=stonetop.movelist.characterLevel}}
				{{else}}
					{{localize "stonetop.character.moves.levelMovesOverLimitMany" count=stonetop.movelist.levelMovesOverage level=stonetop.movelist.characterLevel}}
				{{/if}}
				</p>
				<p class="stonetop-moves-level-notice-hint">{{localize "stonetop.character.moves.levelMovesOverLimitHint"}}</p>
			</div>
			<button type="button" class="stonetop-moves-level-notice-dismiss"
			        data-overage-key="{{stonetop.movelist.levelMovesOverageKey}}"
			        aria-label="{{localize 'stonetop.character.moves.dismissLevelMovesOverLimit'}}"
			        title="{{localize 'stonetop.character.moves.dismissLevelMovesOverLimit'}}">
				<i class="fas fa-times" aria-hidden="true"></i>
			</button>
		</div>
		{{/if}}

		{{#if stonetop.movelist.learnedMoves.length}}
		{{> "stonetop.move-group"
		    title=(localize "stonetop.character.moves.learnedMoves")
		    note=null
		    moves=stonetop.movelist.learnedMoves
		    editSection="moves"
		    collapseId="learnedMoves"
		    editing=stonetop.movesEdit}}
		{{/if}}

		{{#if stonetop.movelist.postDeathGroup}}
		{{> "stonetop.move-group"
		    title=stonetop.movelist.postDeathGroup.label
		    note=null
		    collapseId="postDeathMoves"
		    moves=stonetop.movelist.postDeathGroup.moves}}
		{{/if}}

		{{#if stonetop.playbook}}
		{{#each stonetop.movelist.otherGroups}}
				<div class="stonetop-move-group">
					{{!-- The fold id is the group's stable key, namespaced: `key` alone is the
					      move type ("background", "special", …), and "background" is already
					      the Details tab's Background section — one flat per-actor set holds
					      both, so folding one would fold the other. Keyed off `key` and not
					      `label` because a label is display text: renaming a group would
					      silently drop its fold, and a blank one yields a dead caret. --}}
					{{> "stonetop.section-heading" title=label collapse=(concat "otherMoves:" key)}}
					<ol class="items-list">
					{{#each moves}}
						{{!-- These "other" moves are all real owned items, so every row is a
						      draggable .item (drag onto the hotbar → roll or post-to-chat macro).
						      The dice icon stays gated on rollType. Owned means learned, so they
						      carry `is-checked` like any owned playbook move and survive the
						      tab's "Hide un-learned moves" filter. --}}
						<li class="item stonetop-item is-checked" data-item-id="{{ownedId}}">
							<div class="stonetop-item-header">
								{{#if rollType}}
								<span class="rollable move-rollable" data-roll="{{rollType}}" data-mod="">
									<i class="fas fa-dice-d6"></i>
								</span>
								{{/if}}
								<strong class="stonetop-item-name">{{name}}</strong>
								{{#if (and @root.stonetop.showRollStatChips rollLabel)}}<span class="stonetop-move-roll-chip">+{{rollLabel}}</span>{{/if}}
								{{#if @root.stonetop.movesEdit}}
								<a class="stonetop-other-move-delete" data-item-id="{{ownedId}}" title="{{localize 'stonetop.character.moves.removeMove'}}">
									<i class="fas fa-trash"></i>
								</a>
								{{/if}}
							</div>
						</li>
					{{/each}}
					</ol>
				</div>
				{{/each}}
		{{/if}}

			{{#if stonetop.showOtherMovesSection}}
			<div class="stonetop-move-group stonetop-other-moves-section">
				{{> "stonetop.section-heading" title=(localize "stonetop.character.moves.otherMoves") collapse="otherMoves"}}
				<ol class="items-list">
				{{#each stonetop.movelist.otherMoves}}
					{{!-- `is-checked` marks a LEARNED move exactly as an owned playbook move is
					      marked, so the tab's "Hide un-learned moves" filter (which keys off
					      `.stonetop-item:not(.is-checked)`) treats these the same: learned ones
					      stay visible with the filter on, un-learned ones drop out. --}}
					<li class="item stonetop-item{{#if learned}} is-checked{{else}} move-unlearned{{/if}}" data-item-id="{{ownedId}}">
						<div class="stonetop-item-header">
							{{!-- Custom moves carry a "learned" checkbox (checked by default). Un-checking
							      it in edit mode keeps the move on the sheet but inactive — not rollable,
							      and its HP/armor/load bonuses stop applying. Foreign playbook moves that
							      also land in "other" are always learned, so they show no toggle. --}}
							{{#if custom}}
							<input type="checkbox" class="stonetop-item-check stonetop-custom-move-learned"
							       data-item-id="{{ownedId}}"
							       title="{{localize 'stonetop.character.moves.custom.learnedTitle'}}"
							       {{#if learned}}checked{{/if}}
							       {{#unless @root.stonetop.movesEdit}}disabled{{/unless}}>
							{{else}}
							{{!-- No toggle to show, so hold the checkbox's width: otherwise a foreign
							      playbook move's title starts where every custom move's checkbox is,
							      and the section reads as two ragged columns. --}}
							<span class="stonetop-item-check-spacer" aria-hidden="true"></span>
							{{/if}}
							{{#if (and rollType learned)}}
							<span class="rollable move-rollable" data-roll="{{rollType}}" data-mod="">
								<i class="fas fa-dice-d6"></i>
							</span>
							{{/if}}
							<strong class="stonetop-item-name">{{name}}</strong>
							{{#if (and @root.stonetop.showRollStatChips rollLabel)}}<span class="stonetop-move-roll-chip">+{{rollLabel}}</span>{{/if}}
							{{#if (and resource learned)}}
							{{!-- Right-pins the track while it shares the title's line; see
							      .stonetop-item-header-spacer. --}}
							<span class="stonetop-item-header-spacer" aria-hidden="true"></span>
							<span class="stonetop-item-resources">
								{{#if resource.title}}<span class="stonetop-item-resource-title"{{#if resource.spendTooltip}} data-tooltip="{{resource.spendTooltip}}" data-tooltip-direction="UP"{{/if}}>{{resource.title}}</span>{{/if}}
								{{#each (resourceChecks resource)}}
								<span class="stonetop-item-resource-entry">
									<button type="button" class="stonetop-item-resource-check{{#if checked}} is-checked{{/if}}"
									        data-move-name="{{../resourceKey}}"
									        data-index="{{@index}}"></button>
									{{#if label}}<span class="stonetop-resource-label">{{label}}</span>{{/if}}
								</span>
								{{/each}}
							</span>
							{{/if}}
							{{#if (and custom @root.stonetop.movesEdit @root.stonetop.canAuthorCustomMoves)}}
							<a class="stonetop-custom-move-edit" data-item-id="{{ownedId}}" title="{{localize 'stonetop.character.moves.custom.editMove'}}">
								<i class="fas fa-pen"></i>
							</a>
							{{/if}}
							{{#if (and @root.stonetop.movesEdit (or (not custom) @root.stonetop.canAuthorCustomMoves))}}
							<a class="stonetop-other-move-delete" data-item-id="{{ownedId}}" title="{{localize 'stonetop.character.moves.removeMove'}}">
								<i class="fas fa-trash"></i>
							</a>
							{{/if}}
						</div>
						{{#if description}}<div class="stonetop-item-description">{{{boldMissText description}}}</div>{{/if}}
					</li>
				{{/each}}
				</ol>
			</div>
			{{/if}}

			{{!-- Create-a-move entry point. A quiet dashed button pinned to the foot of the
			      Moves tab, mirroring the Followers tab's "Create a follower" bar. Visible in
			      and out of edit mode so authoring never depends on the Edit toggle. --}}
			{{#if stonetop.canAuthorCustomMoves}}
			<div class="stonetop-move-add-bar">
				<button type="button" class="stonetop-add-custom-move" title="{{localize 'stonetop.character.moves.addMove'}}">
					<i class="fas fa-plus" aria-hidden="true"></i> {{localize "stonetop.character.moves.custom.addButton"}}
				</button>
			</div>
			{{/if}}

	</section>
</div>
