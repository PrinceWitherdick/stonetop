{{#each options}}
		{{! `caution`, `pdiCrossOff` and `pdiUncross` are set only on a post-death insert's options, in
		    edit mode (post-death-outcomes.js): a pick the rules can't account for, flagged and never
		    blocked, and the GM's hand on a Thrall's Marks. A playbook's lore never carries them. }}
		<div class="stonetop-lore-option{{#if (eq type 'text')}} stonetop-lore-option--text{{/if}}{{#if crossedOff}} is-crossed-off{{/if}}{{#if caution}} is-cautioned{{/if}}">
			{{#if (eq type "text")}}
			{{#if description}}<label class="stonetop-lore-option-desc">{{{description}}}</label>{{/if}}
			{{#if arcanaPicker}}
			<select class="stonetop-lore-arcana-select{{#if arcanaPicker.muted}} is-muted{{/if}}" data-role="{{arcanaPicker.role}}">
				<option value="">— choose a card —</option>
				{{#each arcanaPicker.options}}
				<option value="{{slug}}"{{#if (eq slug ../arcanaPicker.selectedSlug)}} selected{{/if}}>{{name}}</option>
				{{/each}}
			</select>
			{{/if}}
			<textarea class="stonetop-lore-option-text{{#if isName}} stonetop-lore-option-text--name{{/if}}"
			          data-lore-slug="{{../slug}}"
			          data-option-slug="{{slug}}"
			          placeholder="To be written."
			          >{{#if hasAnswer}}{{textValue}}{{/if}}</textarea>
			{{else}}
			<span class="stonetop-lore-option-checks">
				{{#each checks}}
				<input type="checkbox" class="stonetop-lore-option-check"
				       data-lore-slug="{{../../slug}}"
				       data-option-slug="{{../slug}}"
				       data-idx="{{@index}}"
				       {{#if this}}checked{{/if}} {{#if ../crossedOff}}disabled{{/if}}>
				{{/each}}
			</span>
			<span class="stonetop-lore-option-desc">{{#if hasBlank}}{{{fillBefore}}}<input type="text" class="stonetop-lore-option-text stonetop-lore-fill" data-lore-slug="{{../slug}}" data-option-slug="{{slug}}" value="{{fillValue}}" placeholder="…">{{{fillAfter}}}{{else}}{{{description}}}{{/if}}</span>
			{{#if caution}}<i class="fas fa-triangle-exclamation stonetop-lore-option-caution" role="img" aria-label="{{caution}}" data-tooltip="{{caution}}" data-tooltip-direction="UP"></i>{{/if}}
			{{#if pdiCrossOff}}
			<button type="button" class="stonetop-pdi-crossoff-btn" data-pdi-action="cross-off" data-slug="{{slug}}"
			        aria-label="{{pdiCrossOff.label}}" data-tooltip="{{pdiCrossOff.label}}">{{localize "stonetop.postDeath.outcomes.crossOff"}}</button>
			{{/if}}
			{{#if pdiUncross}}
			<button type="button" class="stonetop-pdi-crossoff-btn" data-pdi-action="uncross" data-slug="{{slug}}"
			        aria-label="{{pdiUncross.label}}" data-tooltip="{{pdiUncross.label}}">{{localize "stonetop.postDeath.outcomes.uncross"}}</button>
			{{/if}}
			{{/if}}
		</div>
{{/each}}
