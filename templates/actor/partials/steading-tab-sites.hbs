<div class="tab sites steading-edit-section{{#unless stonetop.edit.sites}} stonetop-readonly{{/unless}}" data-group="primary" data-tab="sites">
	{{#if stonetop.isGM}}{{> "stonetop.steading-section-toggle" section="sites" editing=stonetop.edit.sites}}{{/if}}
	{{!-- steading-prep-cards is the shared card chrome (collapse, type scale) this tab
	      wears alongside the Threats & Dangers tab; see stonetop.css. --}}
	<section class="sheet-tab steading-sites steading-prep-cards">

		{{#if stonetop.isGM}}
		<p class="steading-threats-intro">
			Interesting places the PCs can explore (Book I, <em>Sites</em>): the destination of an expedition, a point of interest on the way, or an incidental discovery. Written up here for your eyes only. Drag a card onto a scene to pin it to the map.
		</p>
		{{/if}}

		{{#if stonetop.sites.length}}
		<div class="steading-threats-grid steading-sites-grid">
			{{#each stonetop.sites}}
			<div class="threat-card-wrap" data-page-uuid="{{uuid}}">
				{{> "stonetop.site-card" this}}
				{{#if @root.stonetop.isGM}}
				<div class="threat-card-tools">
					<button type="button" class="site-edit-open" data-page-uuid="{{uuid}}" data-tooltip="Edit site" data-tooltip-direction="UP"><i class="fas fa-pen"></i></button>
					<button type="button" class="site-remove" data-page-uuid="{{uuid}}" data-tooltip="Delete site" data-tooltip-direction="UP"><i class="fas fa-trash"></i></button>
				</div>
				{{/if}}
			</div>
			{{/each}}
		</div>
		{{/if}}

		{{#if stonetop.isGM}}
		<div class="steading-improvement-add-bar">
			<button type="button" class="site-add-btn"><i class="fas fa-plus"></i> Create a site</button>
		</div>
		{{/if}}

	</section>
</div>
