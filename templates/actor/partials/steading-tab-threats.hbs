<div class="tab threats steading-edit-section{{#unless stonetop.edit.threats}} stonetop-readonly{{/unless}}" data-group="primary" data-tab="threats">
	{{#if stonetop.isGM}}{{> "stonetop.steading-section-toggle" section="threats" editing=stonetop.edit.threats}}{{/if}}
	{{!-- steading-prep-cards is the shared card chrome (collapse, type scale) this tab
	      wears alongside the Sites tab; see stonetop.css. --}}
	<section class="sheet-tab steading-threats steading-prep-cards">

		{{#if stonetop.isGM}}
		<p class="steading-threats-intro">
			Ongoing problems that will trouble Stonetop if left unchecked (Book I, <em>Threats</em>). Written up here for your eyes only. Drag a card onto a scene to pin it to the map.
		</p>
		{{/if}}

		{{!-- One section per proximity tracker (Homefront / Nearby / Distant), mirroring the
		      Residents tab's stacked Player/Residents/Neighbors sections, each with its own
		      "write up" button that pre-seeds that proximity. This whole tab is GM-only. --}}
		{{#each stonetop.threatGroups}}
		<div class="steading-threats-section">
			{{!-- Folded under the proximity's stable id ("homefront" / "nearby" / "distant"),
			      not its label: a label is display text, so a copy edit would silently drop
			      the fold and a blank one would leave a caret that does nothing. --}}
			<h3 class="steading-residents-heading">{{label}} Threats{{> "stonetop.section-collapse" collapse=id}}</h3>
			{{#if threats.length}}
			<div class="steading-threats-grid">
				{{#each threats}}
				<div class="threat-card-wrap" data-page-uuid="{{uuid}}">
					{{> "stonetop.threat-card" this}}
					{{#if @root.stonetop.isGM}}
					<div class="threat-card-tools">
						<button type="button" class="threat-edit-open" data-page-uuid="{{uuid}}" data-tooltip="Edit threat" data-tooltip-direction="UP"><i class="fas fa-pen"></i></button>
						<button type="button" class="threat-remove" data-page-uuid="{{uuid}}" data-tooltip="Delete threat" data-tooltip-direction="UP"><i class="fas fa-trash"></i></button>
					</div>
					{{/if}}
				</div>
				{{/each}}
			</div>
			{{/if}}
			{{#if @root.stonetop.isGM}}
			<div class="steading-improvement-add-bar">
				<button type="button" class="threat-add-btn" data-proximity="{{id}}"><i class="fas fa-plus"></i> Write up a {{lowerLabel}} threat</button>
			</div>
			{{/if}}
		</div>
		{{/each}}

		{{!-- Hazards: the environmental half of Book I "Dangers", one flat section after
		      the proximity groups (hazards have no proximity; they belong to places and
		      expeditions). Same card affordances as threats: drag-to-pin, collapse; the pen
		      reopens the Make-a-Hazard walkthrough pre-filled. --}}
		{{#if stonetop.showHazards}}
		<div class="steading-threats-section steading-hazards-section">
			<h3 class="steading-residents-heading">Hazards{{> "stonetop.section-collapse" collapse="hazards"}}</h3>
			{{#if stonetop.isGM}}
			<p class="steading-threats-intro">
				Environmental dangers: traps, treacherous terrain, weather (Book I, <em>Dangers</em>). They can't be fought, only avoided, endured, thwarted, or overcome.
			</p>
			{{/if}}
			{{#if stonetop.hazards.length}}
			<div class="steading-threats-grid">
				{{#each stonetop.hazards}}
				<div class="threat-card-wrap" data-page-uuid="{{uuid}}">
					{{> "stonetop.hazard-card" this}}
					{{#if @root.stonetop.isGM}}
					<div class="threat-card-tools">
						<button type="button" class="hazard-edit-open" data-page-uuid="{{uuid}}" data-tooltip="Edit hazard" data-tooltip-direction="UP"><i class="fas fa-pen"></i></button>
						<button type="button" class="hazard-remove" data-page-uuid="{{uuid}}" data-tooltip="Delete hazard" data-tooltip-direction="UP"><i class="fas fa-trash"></i></button>
					</div>
					{{/if}}
				</div>
				{{/each}}
			</div>
			{{/if}}
			{{#if stonetop.isGM}}
			<div class="steading-improvement-add-bar">
				<button type="button" class="hazard-add-btn"><i class="fas fa-plus"></i> Make a hazard</button>
			</div>
			{{/if}}
		</div>
		{{/if}}

	</section>
</div>
