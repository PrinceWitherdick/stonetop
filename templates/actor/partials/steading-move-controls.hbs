{{!-- The roll control and stat chip for one steading move — the part that is identical
      whichever shape the move is drawn in.

      Mounted from inside `{{#each stonetop.moves}}` in both steading-tab-moves.hbs (the MODERN
      card) and steading-moves-sidebar.hbs (the CLASSIC row), which differ in their wrapper,
      their name element and where the description goes, but agree exactly on this. The class
      names here are what StonetopSteadingSheet's delegated handlers bind to, so a copy that
      drifted would silently stop rolling.

      Uses `@root` rather than `../` for the chip gate, so it resolves at either mount depth. --}}
{{#if interactive}}
<button type="button" class="steading-interactive-btn rollable move-rollable"
        data-move-slug="{{slug}}"
        title="{{label}}">
	<i class="fas fa-dice-d6"></i>
</button>
{{else}}
{{#if rollable}}
<button type="button" class="steading-roll-btn rollable move-rollable"
        data-move-name="{{label}}" data-stat="{{stat}}"
        title="Roll 2d6+{{this.statLabel}}">
	<i class="fas fa-dice-d6"></i>
</button>
{{/if}}
{{/if}}
{{#if (and @root.stonetop.showRollStatChips statChipLabel)}}
<span class="stonetop-move-roll-chip steading-move-stat-tag">+{{this.statChipLabel}}</span>
{{/if}}
