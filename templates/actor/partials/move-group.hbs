<div class="stonetop-move-group">
	{{#if editSection}}
	<div class="stonetop-details-heading-row">
		{{> "stonetop.section-heading" title=title note=note}}
		{{> "stonetop.details-section-edit-toggle" section=editSection editing=editing}}
	</div>
	{{else}}
	{{> "stonetop.section-heading" title=title note=note}}
	{{/if}}
	{{#if hideToggle}}
	<label class="stonetop-hide-unselected-label">
		<input type="checkbox" class="stonetop-hide-unselected-check"{{#if hideUnselected}} checked{{/if}}>
		Hide un-learned moves
	</label>
	{{/if}}
	<ol class="items-list">
	{{#each moves}}
		{{#if (and owned rollType)}}
		<li class="item stonetop-item is-checked{{#if requirementsUnmet}} move-requirements-unmet{{/if}}{{#if markBudget.needsChoice}} move-needs-choice{{/if}}{{#if isStarting}} move-starting{{/if}}" data-item-id="{{ownedId}}">
		{{else}}
		<li class="stonetop-item{{#if owned}} is-checked{{/if}}{{#if (and locked (not owned))}} move-locked{{/if}}{{#if requirementsUnmet}} move-requirements-unmet{{/if}}{{#if markBudget.needsChoice}} move-needs-choice{{/if}}{{#if isStarting}} move-starting{{/if}}">
		{{/if}}
			<div class="stonetop-item-header">
				{{#if repeatable}}
				<span class="stonetop-repeat-checks">
					{{#each (repeatChecks this)}}
					<input type="checkbox" class="stonetop-item-check stonetop-repeat-check"
					       data-compendium-id="{{../compendiumId}}"
					       data-owned-id="{{ownedId}}"
					       data-move-name="{{../name}}"
					       {{#if checked}}checked{{/if}}
					       {{#if (or disabled (not @root.stonetop.movesEdit))}}disabled{{/if}}>
					{{/each}}
				</span>
				{{else}}
				<input type="checkbox" class="stonetop-item-check stonetop-move-check"
				       data-compendium-id="{{compendiumId}}"
				       data-owned-id="{{ownedId}}"
				       data-move-name="{{name}}"
				       {{#if owned}}checked{{/if}}
				       {{!-- An owned starting move is locked (can't be dropped); an UNowned one
				             — the unpicked side of an "either X OR Y" choice — stays pickable
				             in edit mode so the choice can be made/changed by hand on the sheet.
			             A move whose requirements aren't met stays faded (.move-locked) but is
			             still pickable in edit mode, so a player can deliberately learn it anyway
			             — it then shows the "requirement not met" warning. --}}
				       {{#if (or (and isStarting owned) (not @root.stonetop.movesEdit))}}disabled{{/if}}>
				{{/if}}
				{{#if (and owned rollType)}}
				<span class="rollable move-rollable" data-roll="{{rollType}}" data-mod="">
					<i class="fas fa-dice-d6"></i>
				</span>
				{{/if}}
				{{#if (and @root.stonetop.showRollStatChips rollLabel)}}<span class="stonetop-move-roll-chip">+{{rollLabel}}</span>{{/if}}
				<strong class="stonetop-item-name">{{name}}{{#if asterisk}}<span class="stonetop-move-asterisk" data-tooltip="The first time you use this move, cross off &quot;Would-be&quot; — you become a Hero." data-tooltip-direction="UP"> *</span>{{/if}}</strong>
				{{#if requirementsUnmet}}<i class="fas fa-triangle-exclamation stonetop-move-req-warning" data-tooltip="You own this move but do not meet its requirement{{#if requiresLabel}} ({{requiresLabel}}){{/if}}. Add the missing prerequisite, or drop this move." data-tooltip-direction="UP" aria-hidden="true"></i>{{/if}}
				{{#if markBudget.needsChoice}}<i class="fas fa-hand-pointer stonetop-move-choice-needed" data-tooltip="This move has selections left to make ({{markBudget.used}} of {{markBudget.max}} chosen) — tap the hand to jump into the moves editor and choose the rest." data-tooltip-direction="UP" role="button" tabindex="0"></i>{{/if}}
				{{#if (and owned resource)}}
				<span class="stonetop-item-resources">
					{{#if resource.title}}<span class="stonetop-item-resource-title"{{#if resource.spendTooltip}} data-tooltip="{{resource.spendTooltip}}" data-tooltip-direction="UP"{{/if}}>{{resource.title}}</span>{{/if}}
					{{#each (resourceChecks resource)}}
					<span class="stonetop-item-resource-entry">
						<button type="button" class="stonetop-item-resource-check{{#if checked}} is-checked{{/if}}"
						        data-move-name="{{../name}}"
						        data-index="{{@index}}"></button>
						{{#if label}}<span class="stonetop-resource-label">{{label}}</span>{{/if}}
					</span>
					{{/each}}
				</span>
				{{/if}}
				{{#if sourceLabel}}<span class="stonetop-item-source">{{sourceLabel}}</span>{{/if}}
				{{#if (and @root.stonetop.movesEdit owned (lookup @root.stonetop.possessionTriggerMoves name))}}
				<a class="stonetop-move-possession-edit" data-possession-choices="{{lookup @root.stonetop.possessionTriggerMoves name}}"
				   data-tooltip="Choose your sacred pouch's remarkable trait(s)" data-tooltip-direction="UP">
					<i class="fas fa-pen-to-square" aria-hidden="true"></i>
				</a>
				{{/if}}
			</div>
			<div class="stonetop-item-description">{{{boldMissText description}}}</div>
			{{#if markBudget}}
			<p class="stonetop-move-mark-budget{{#if markBudget.atBudget}} is-at-budget{{/if}}{{#if markBudget.over}} is-over{{/if}}"
			   data-tooltip="Each time you take this move you may choose another option." data-tooltip-direction="UP">
				{{markBudget.used}} / {{markBudget.max}} chosen
			</p>
			{{/if}}
			{{#if markOptions}}
			<ul class="stonetop-move-marks">
				{{#each markOptions}}
				<li class="stonetop-move-mark">
					{{#if statSlots}}
					<span class="stonetop-move-mark-label">{{label}}</span>
					<span class="stonetop-move-mark-slots">
						{{#each statSlots}}
						<span class="stonetop-move-mark-slot">
							<select class="stonetop-move-mark-stat"
							        data-move-name="{{../../name}}"
							        data-mark-slug="{{../slug}}"
							        data-idx="{{index}}"
							        {{#unless @root.stonetop.movesEdit}}disabled{{/unless}}>
								{{#each options}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{abbr}}</option>{{/each}}
							</select>
							{{> "stonetop.move-mark-level" moveName=../../name slug=../slug index=index level=level}}
						</span>
						{{/each}}
					</span>
					{{else}}
					<span class="stonetop-move-mark-checks">
						{{#each checks}}
						<input type="checkbox" class="stonetop-move-mark-check"
						       data-move-name="{{../../name}}"
						       data-mark-slug="{{../slug}}"
						       data-idx="{{index}}"
						       {{#if checked}}checked{{/if}}
						       {{#if (or disabled (not @root.stonetop.movesEdit))}}disabled{{/if}}>
						{{/each}}
					</span>
					<span class="stonetop-move-mark-label">{{label}}</span>
					{{#each checks}}{{#if checked}}{{> "stonetop.move-mark-level" moveName=../../name slug=../slug index=index level=level}}{{/if}}{{/each}}
					{{/if}}
				</li>
				{{/each}}
			</ul>
			{{/if}}
			{{#if statChoices}}
			<div class="stonetop-stat-choices">
				{{#each statChoices}}
				{{#if statKey}}
				<span class="stonetop-stat-boost-chip">+1 {{statAbbr}}</span>
				{{/if}}
				{{/each}}
			</div>
			{{/if}}
			{{#if backgroundAnswer}}
			<p class="stonetop-move-note stonetop-move-background-answer">
				{{backgroundAnswer.label}}: {{backgroundAnswer.value}}
			</p>
			{{/if}}
			{{#if requiresLabel}}<p class="stonetop-move-note{{#if requirementsUnmet}} stonetop-move-note--unmet{{/if}}">Requires: {{requiresLabel}}{{#if requirementsUnmet}} — not met{{/if}}</p>{{/if}}
			{{#if requiresPlaybook}}<p class="stonetop-move-note{{#if requirementsUnmet}} stonetop-move-note--unmet{{/if}}">Requires {{requiresPlaybook}} playbook</p>{{/if}}
			{{#if minLevel}}<p class="stonetop-move-note{{#if requirementsUnmet}} stonetop-move-note--unmet{{/if}}">Level {{minLevel}}+</p>{{/if}}
		</li>
	{{/each}}
	</ol>
</div>
