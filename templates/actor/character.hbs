<form class="{{cssClass}}" autocomplete="off">
	<div class="sheet-wrapper">

		{{> "stonetop.actor-header"}}

		{{#unless stonetop.playbook}}
		<div class="stonetop-no-playbook-state">
			{{#if editable}}
			<button type="button" class="stonetop-create-character-btn">
				<i class="fas fa-user-plus"></i>
				{{localize "stonetop.newCharacter.createButtonLabel"}}
			</button>
			{{/if}}
		</div>
		{{else}}

		<section class="sheet-top flexcol">
			<div class="stonetop-details-heading-row">
				{{> "stonetop.section-heading" title=(localize "stonetop.character.stats.sectionTitle") note=stonetop.statsNoteDisplay}}
				{{> "stonetop.details-section-edit-toggle" section="stats" editing=stonetop.statsEdit}}
			</div>

			<section class="sheet-attributes flexrow">
				{{> "stonetop.actor-stats"}}
			</section>
			<div class="stonetop-debilities">
				<div class="stonetop-debility">
					<span class="stonetop-debility-bracket"></span>
					<label class="stonetop-debility-control" data-tooltip="Fatigued, tired, sluggish, shaky. Disadvantage on +STR or +DEX rolls." data-tooltip-direction="UP">
						<input type="checkbox" class="attr-list"
						       name="system.attributes.debilities.options.weakened.value"
						       {{#if system.attributes.debilities.options.weakened.value}}checked{{/if}}>
						<span class="stonetop-debility-label">weakened</span>
					</label>
				</div>
				<div class="stonetop-debility">
					<span class="stonetop-debility-bracket"></span>
					<label class="stonetop-debility-control" data-tooltip="Out of it, befuddled, not thinking clearly. Disadvantage on +INT or +WIS rolls." data-tooltip-direction="UP">
						<input type="checkbox" class="attr-list"
						       name="system.attributes.debilities.options.dazed.value"
						       {{#if system.attributes.debilities.options.dazed.value}}checked{{/if}}>
						<span class="stonetop-debility-label">dazed</span>
					</label>
				</div>
				<div class="stonetop-debility">
					<span class="stonetop-debility-bracket"></span>
					<label class="stonetop-debility-control" data-tooltip="Greatly distressed, angry, unwell, in pain. Disadvantage on +CON or +CHA rolls." data-tooltip-direction="UP">
						<input type="checkbox" class="attr-list"
						       name="system.attributes.debilities.options.miserable.value"
						       {{#if system.attributes.debilities.options.miserable.value}}checked{{/if}}>
						<span class="stonetop-debility-label">miserable</span>
					</label>
				</div>
			</div>

			{{#if stonetop.woundsView.show}}
			<div class="stonetop-wounds">
				<div class="stonetop-wounds-header">
					<span class="stonetop-wounds-title">wounds</span>
					{{#if stonetop.woundsView.canEdit}}
					<button type="button" class="stonetop-wound-add" data-tooltip="Add a problematic or permanent wound">
						<i class="fas fa-plus"></i>
					</button>
					{{/if}}
				</div>

				{{#if stonetop.woundsView.active.length}}
				<ul class="stonetop-wound-list">
					{{#each stonetop.woundsView.active}}
					<li class="stonetop-wound stonetop-wound--{{this.status}}{{#if this.isDeathsDoor}} is-deaths-door{{/if}}" data-wound-id="{{this.id}}">
						<span class="stonetop-wound-glyph" data-tooltip="{{this.statusLabel}}"><i class="fas {{this.glyph}}"></i></span>
						<span class="stonetop-wound-body">
							<span class="stonetop-wound-text" data-tooltip="{{this.text}}">{{#if this.isDeathsDoor}}<i class="fas fa-skull stonetop-wound-dd" data-tooltip="Death's Door mark"></i> {{/if}}{{#if this.text}}{{this.text}}{{else}}<em class="stonetop-wound-empty">(describe the wound)</em>{{/if}}</span>
							{{#if this.requirementNote}}<span class="stonetop-wound-note"><i class="fas fa-clipboard-list"></i> {{this.requirementNote}}</span>{{/if}}
							{{#if this.planNote}}<span class="stonetop-wound-note"><i class="fas fa-scroll"></i> {{this.planNote}}</span>{{/if}}
							{{#if this.mechanicalTag}}<span class="stonetop-wound-tag" data-tooltip="{{this.mechanicalTag}}"><i class="fas fa-triangle-exclamation"></i> {{this.mechanicalTag}}</span>{{/if}}
						</span>
						{{#if ../stonetop.woundsView.canEdit}}
						<span class="stonetop-wound-actions">
							{{#if this.gmOnly}}<i class="fas fa-user-secret stonetop-wound-gm" data-tooltip="Hidden from players"></i>{{/if}}
							{{#if (eq this.status "problematic")}}<button type="button" class="stonetop-wound-tend" data-tooltip="Tend (Recover)"><i class="fas fa-hand-holding-heart"></i></button>{{/if}}
							<button type="button" class="stonetop-wound-edit" data-tooltip="Edit"><i class="fas fa-pen"></i></button>
							<button type="button" class="stonetop-wound-remove" data-tooltip="Remove"><i class="fas fa-trash"></i></button>
						</span>
						{{/if}}
					</li>
					{{/each}}
				</ul>
				{{/if}}

				{{#if stonetop.woundsView.scarCount}}
				<details class="stonetop-wound-scars">
					<summary>Scars ({{stonetop.woundsView.scarCount}})</summary>
					<ul class="stonetop-wound-list stonetop-wound-list--scars">
						{{#each stonetop.woundsView.scars}}
						<li class="stonetop-wound stonetop-wound--scar{{#if this.isDeathsDoor}} is-deaths-door{{/if}}" data-wound-id="{{this.id}}">
							<span class="stonetop-wound-glyph"><i class="fas fa-heart-crack"></i></span>
							<span class="stonetop-wound-body">
								<span class="stonetop-wound-text" data-tooltip="{{this.text}}">{{#if this.isDeathsDoor}}<i class="fas fa-skull stonetop-wound-dd"></i> {{/if}}{{this.text}}</span>
							</span>
							{{#if ../stonetop.woundsView.canEdit}}
							<span class="stonetop-wound-actions">
								<button type="button" class="stonetop-wound-edit" data-tooltip="Edit"><i class="fas fa-pen"></i></button>
								<button type="button" class="stonetop-wound-remove" data-tooltip="Remove"><i class="fas fa-trash"></i></button>
							</span>
							{{/if}}
						</li>
						{{/each}}
					</ul>
				</details>
				{{/if}}
			</div>
			{{/if}}

			<section class="sheet-attributes-top">
				{{> "stonetop.actor-vitals"}}
			</section>

		</section>

		<section class="sheet-main flexcol">
			<nav class="sheet-tabs tabs" data-group="primary">
				<a class="item" data-tab="moves"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.moves"}}</span></a>
				{{#if stonetop.invocations}}<a class="item" data-tab="invocations"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.invocations"}}</span></a>{{/if}}
				{{#if stonetop.showFollowersTab}}<a class="item" data-tab="followers"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.followers"}}</span></a>{{/if}}
				<a class="item" data-tab="inventory"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.inventory"}}</span></a>
				{{#if stonetop.hasArcana}}<a class="item" data-tab="arcana"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.arcana"}}</span></a>{{/if}}
				<a class="item" data-tab="details"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.details"}}</span></a>
				{{#if stonetop.showPostDeath}}<a class="item" data-tab="post-death"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.postDeath"}}</span></a>{{/if}}
				<a class="item" data-tab="special-moves"><span class="stonetop-tab-label">{{localize "stonetop.sheet.tabs.specialMoves"}}</span></a>
			</nav>

			<div class="stonetop-sheet-layout">
				<section class="sheet-body">
					{{> "stonetop.tab-moves"}}
					{{#if stonetop.invocations}}{{> "stonetop.tab-invocations"}}{{/if}}
					{{#if stonetop.showFollowersTab}}{{> "stonetop.tab-followers"}}{{/if}}
					{{> "stonetop.tab-equipment"}}
					{{#if stonetop.hasArcana}}{{> "stonetop.tab-arcana"}}{{/if}}
					{{> "stonetop.tab-details"}}
					{{#if stonetop.showPostDeath}}{{> "stonetop.tab-post-death"}}{{/if}}
					{{> "stonetop.tab-special-moves"}}
				</section>

				<div class="stonetop-moves-sidebar{{#if stonetop.sidebarCollapsed}} is-collapsed{{/if}}">
					<button type="button" class="stonetop-sidebar-toggle"
					        aria-expanded="{{#if stonetop.sidebarCollapsed}}false{{else}}true{{/if}}"
					        aria-label="{{#if stonetop.sidebarCollapsed}}Expand moves sidebar{{else}}Collapse moves sidebar{{/if}}">
						<i class="fas fa-chevron-right"></i>
					</button>
					<div class="stonetop-sidebar-body">
					{{> "stonetop.section-heading" title="Roll Modifier"}}
					<div class="stonetop-roll-mode-control" role="group" aria-label="Roll mode">
						<label class="stonetop-roll-mode-option{{#if (eq stonetop.rollMode "adv")}} is-checked{{/if}}">
							<input type="radio" class="stonetop-roll-mode-input" name="stonetop-roll-mode" value="adv"
							       {{#if (eq stonetop.rollMode "adv")}}checked{{/if}}
							       {{#unless editable}}disabled{{/unless}}>
							<span>Advantage</span>
						</label>
						<label class="stonetop-roll-mode-option{{#if (eq stonetop.rollMode "normal")}} is-checked{{/if}}">
							<input type="radio" class="stonetop-roll-mode-input" name="stonetop-roll-mode" value="normal"
							       {{#if (eq stonetop.rollMode "normal")}}checked{{/if}}
							       {{#unless editable}}disabled{{/unless}}>
							<span>Normal</span>
						</label>
						<label class="stonetop-roll-mode-option{{#if (eq stonetop.rollMode "dis")}} is-checked{{/if}}">
							<input type="radio" class="stonetop-roll-mode-input" name="stonetop-roll-mode" value="dis"
							       {{#if (eq stonetop.rollMode "dis")}}checked{{/if}}
							       {{#unless editable}}disabled{{/unless}}>
							<span>Disadvantage</span>
						</label>
					</div>

					{{> "stonetop.sidebar-move-list" moves=stonetop.movelist.basicMoves titleKey="stonetop.character.moves.basicMoves" openClass="stonetop-basic-move-open" sectionId="basicMoves" open=stonetop.movesOpen.basicMoves}}
					{{> "stonetop.sidebar-move-list" moves=stonetop.movelist.expeditionMoves titleKey="stonetop.character.moves.expeditionMoves" openClass="stonetop-expedition-move-open" sectionId="expeditionMoves" open=stonetop.movesOpen.expeditionMoves}}
					</div>
				</div>
			</div>
		</section>

		{{/unless}}

	</div>
</form>
