{{!-- One fighter in the Fight tab. Called with `row` (fight-view.js's row) and `gm` (whether the
      reader is a GM), both passed IN, because inside the tracker's {{#each}} loops the outer
      context is out of reach of a partial.

      Core's `combatant` class, `data-combatant-id` and `activateCombatant` action stay: core lights
      the token on hover and pans to it on click through them. Its row buttons (hide, out, ping)
      are core's own actions too.

      The count badge is TEXT with a label, not a colour: "Fought by 3" is read out and shown on
      hover, and the number is printed, so the tab says who is being ganged up on without anyone
      having to see the map.

      Source order is reading order: name, what they are doing, the badge, then the buttons. The
      stylesheet lifts the badge and the buttons up beside the name, so a row costs no extra line. --}}
<li class="combatant stonetop-fight-row {{row.css}}" data-combatant-id="{{row.id}}" data-action="activateCombatant">
  {{#if row.img}}<img class="stonetop-fight-face" src="{{row.img}}" alt="" loading="lazy">{{/if}}
  <div class="stonetop-fight-row-text">
    <strong class="name stonetop-fight-name">{{row.name}}</strong>
    {{#if row.readout}}<span class="stonetop-fight-readout">{{row.readout}}</span>{{/if}}
    {{#if row.standing}}<span class="stonetop-fight-standing">{{row.standing}}</span>{{/if}}
    {{#if row.badge}}
    <span class="stonetop-fight-badge" role="img" aria-label="{{row.badge.label}}" data-tooltip-text="{{row.badge.label}}">&times;{{row.badge.count}}</span>
    {{/if}}
    <div class="combatant-controls stonetop-fight-controls">
      {{#if gm}}
      <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash{{#if row.hidden}} active{{/if}}"
              data-action="toggleHidden" aria-pressed="{{#if row.hidden}}true{{else}}false{{/if}}"
              data-tooltip="{{#if row.hidden}}{{localize "stonetop.fight.row.show"}}{{else}}{{localize "stonetop.fight.row.hide"}}{{/if}}"
              aria-label="{{#if row.hidden}}{{localize "stonetop.fight.row.show"}}{{else}}{{localize "stonetop.fight.row.hide"}}{{/if}}"></button>
      <button type="button" class="inline-control combatant-control icon fa-solid fa-skull{{#if row.defeated}} active{{/if}}"
              data-action="toggleDefeated" aria-pressed="{{#if row.defeated}}true{{else}}false{{/if}}"
              data-tooltip="{{#if row.defeated}}{{localize "stonetop.fight.row.backIn"}}{{else}}{{localize "stonetop.fight.row.out"}}{{/if}}"
              aria-label="{{#if row.defeated}}{{localize "stonetop.fight.row.backIn"}}{{else}}{{localize "stonetop.fight.row.out"}}{{/if}}"></button>
      {{/if}}
      {{#if row.canPing}}
      <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow" data-action="pingCombatant"
              data-tooltip="{{localize "stonetop.fight.row.ping"}}" aria-label="{{localize "stonetop.fight.row.ping"}}"></button>
      {{/if}}
    </div>
  </div>
</li>
