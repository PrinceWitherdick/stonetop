{{!-- Shared, book-faithful "GM note" threat card. Rendered from buildThreatCardVM
      by the page sheet (view), the steading Threats tab, and the canvas overlay.
      Doom-track checkboxes carry data-portent-index / data-doom + the card's
      data-page-uuid so every host wires the same toggle. Host-specific chrome
      (edit / remove / expand) is added by the host around this partial. --}}
{{!-- When the host marks the card draggable the WHOLE card is the drag handle (no grip):
      grab it anywhere to drop a pinned Note on a scene. The dragstart is wired on the tab
      root in StonetopSteadingSheet._activateThreatsListeners. --}}
<article class="threat-card threat-card--{{type.id}}{{#if revealed}} is-revealed{{/if}}{{#if collapsed}} is-collapsed{{/if}}{{#if canDrag}} is-draggable{{/if}}"
         data-threat-id="{{id}}" data-page-uuid="{{uuid}}" style="--threat-accent:{{accent}};"{{#if canDrag}} draggable="true"{{/if}}>
	<span class="threat-card__edge" aria-hidden="true"></span>

	<header class="threat-card__head{{#if collapsible}} threat-card__head--collapsible{{/if}}">
		{{#if collapsible}}
		{{!-- Host-added collapse chrome (steading Threats tab only): clamps the card to
		      its title + Instinct. The chevron reflects/announces state; clicking anywhere
		      on the header toggles it (see StonetopSteadingSheet._activateThreatsListeners). --}}
		<button type="button" class="threat-collapse-btn"
		        aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
		        aria-label="Collapse or expand this threat" tabindex="0">
			<i class="fas fa-chevron-down" aria-hidden="true"></i>
		</button>
		{{/if}}
		<div class="threat-card__title">
			<h3 class="threat-name">{{name}}</h3>
			<span class="threat-type">{{type.label}}</span>
		</div>
		{{#if isOwner}}
		<button type="button" class="threat-reveal{{#if revealed}} is-revealed{{/if}}"
		        data-threat-reveal data-page-uuid="{{uuid}}"
		        data-tooltip="{{#if revealed}}Players can see this threat &mdash; click to hide{{else}}Hidden from players &mdash; click to reveal{{/if}}"
		        aria-label="{{#if revealed}}Visible to players &mdash; click to hide{{else}}Hidden from players &mdash; click to reveal{{/if}}">
			<i class="fas {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
		</button>
		{{/if}}
	</header>

	{{#if hasInstinct}}
	<p class="threat-instinct"><span class="threat-label">Instinct</span><em>{{instinct}}</em></p>
	{{/if}}
	{{#if hasThemes}}
	<p class="threat-themes"><span class="threat-label">Themes</span>{{#each themes}}<span class="threat-themes__item">{{this}}</span>{{/each}}</p>
	{{/if}}
	{{#if hasAspects}}
	<p class="threat-themes threat-aspects"><span class="threat-label">Aspects</span>{{#each aspects}}<span class="threat-themes__item">{{this}}</span>{{/each}}</p>
	{{/if}}
	<p class="threat-proximity"><span class="threat-proximity__pip" aria-hidden="true"></span>{{proximity.label}} threat</p>

	{{#if hasDescription}}
	<div class="threat-desc">{{{description}}}</div>
	{{/if}}

	{{#if hasDoomTrack}}
	{{> "stonetop.card-doom-track"}}
	{{/if}}

	{{#if hasStakes}}
	<p class="threat-stakes"><span class="threat-label">Stakes</span>{{#each stakes}}<span class="threat-stakes__q">{{this}}</span>{{/each}}</p>
	{{/if}}

	{{> "stonetop.card-gm-moves"}}

	{{#if hasCleansing}}
	<div class="threat-moves threat-cleansing">
		<span class="threat-label">Cleansing</span>
		<ul class="threat-move-list">
			{{#each cleansing}}<li><span class="threat-move-caret" aria-hidden="true">&#x27a4;</span>{{this}}</li>{{/each}}
		</ul>
	</div>
	{{/if}}

	{{#if hasNested}}
	<p class="threat-nested"><span class="threat-label">Also</span>{{#each nested}}<span class="threat-nested__item">{{name}} <em>({{type}}{{#if instinct}}; {{instinct}}{{/if}})</em></span>{{/each}}</p>
	{{/if}}

	{{> "stonetop.card-player-moves"}}
</article>
