{{!-- Shared, book-faithful "GM note" hazard card. Rendered from buildHazardCardVM
      by the page sheet (view), the steading tab's Hazards section, and the canvas
      overlay. It reuses the threat card's classes (.threat-card wrapper, portent
      checkboxes, reveal button) so the shared threat-view wiring and the card CSS
      apply unchanged; hazard-specific rows carry .hazard-* classes on top. --}}
<article class="threat-card threat-card--hazard hazard-card{{#if revealed}} is-revealed{{/if}}{{#if collapsed}} is-collapsed{{/if}}{{#if canDrag}} is-draggable{{/if}}"
         data-hazard-id="{{id}}" data-page-uuid="{{uuid}}" style="--threat-accent:{{accent}};"{{#if canDrag}} draggable="true"{{/if}}>
	<span class="threat-card__edge" aria-hidden="true"></span>

	<header class="threat-card__head{{#if collapsible}} threat-card__head--collapsible{{/if}}">
		{{#if collapsible}}
		<button type="button" class="threat-collapse-btn"
		        aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
		        aria-label="Collapse or expand this hazard" tabindex="0">
			<i class="fas fa-chevron-down" aria-hidden="true"></i>
		</button>
		{{/if}}
		<div class="threat-card__title">
			<h3 class="threat-name">{{name}}</h3>
			<span class="threat-type">Hazard</span>
		</div>
		{{#if isOwner}}
		<button type="button" class="threat-reveal{{#if revealed}} is-revealed{{/if}}"
		        data-threat-reveal data-page-uuid="{{uuid}}"
		        data-tooltip="{{#if revealed}}Players can see this hazard &mdash; click to hide{{else}}Hidden from players &mdash; click to reveal{{/if}}"
		        aria-label="{{#if revealed}}Visible to players &mdash; click to hide{{else}}Hidden from players &mdash; click to reveal{{/if}}">
			<i class="fas {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
		</button>
		{{/if}}
	</header>

	{{#if hasInstinct}}
	<p class="threat-instinct"><span class="threat-label">Instinct</span><em>{{instinct}}</em></p>
	{{/if}}

	{{#if hasDamage}}
	<p class="hazard-damage{{#if certainDeath}} hazard-damage--certain{{/if}}">
		<span class="threat-label">Damage</span><strong>{{damage}}</strong>
	</p>
	{{/if}}

	{{#if hasDescription}}
	<div class="threat-desc">{{{description}}}</div>
	{{/if}}

	{{#if hasAdvanceTrigger}}
	<p class="hazard-advance"><span class="threat-label">Advance</span>{{advanceTrigger}}</p>
	{{/if}}

	{{#if hasDoomTrack}}
	{{> "stonetop.card-doom-track"}}
	{{/if}}

	{{> "stonetop.card-gm-moves"}}

	{{> "stonetop.card-player-moves"}}
</article>
